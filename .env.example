# Copia este archivo a .env y pon tus valores: cp .env.example .env
# .env tiene secretos y NO se sube al repositorio (está en .gitignore). Este archivo sí.
DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse_blog
# La clave que firma los JWT (mínimo 32 caracteres). Genera la tuya con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=paste-a-generated-key-with-at-least-32-chars
# Opcionales: tienen default en app/config.py. En producción, APP_ENV=production
# APP_ENV=development
# RATE_LIMIT_PER_MINUTE=30
# LOGIN_RATE_LIMIT_PER_MINUTE=5
